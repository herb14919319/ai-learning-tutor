{
  "schema_version": "0.2",
  "extends": "learning_chunk_schema_v0_1.json",
  "description": "v0.1 fields plus optional directed relationships for source-supported concept dependencies.",
  "required": ["chunk_id", "title", "chapter", "section", "chunk_type", "source_evidence", "teaching_interpretation"],
  "chunk_types": ["concept", "definition", "comparison", "process", "visual", "exam_point", "example"],
  "source_evidence_required": ["source_file", "source_pages", "source_title", "observations"],
  "teaching_interpretation_required": ["core_concept", "explanation", "exam_focus", "related_concepts"],
  "relationships_optional": true,
  "relationship_required": ["predicate", "target_chunk_id"],
  "relationship_predicates": ["exploits", "belongs_to", "contributes_to"],
  "locator_note": "source_pages are one-based PDF page numbers"
}
